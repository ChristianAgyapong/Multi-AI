# ─────────────────────────────────────────────────────────────────────────────
# Multimodal AI Tutor — Environment Configuration
# Copy to `.env` for local development, or set these variables in your
# Render service dashboard for productions
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: "gemini" | "openai" | "anthropic" | "ollama" | (empty = auto-detect)
# For free production hosting, Google Gemini (free tier) is recommended.
LLM_PROVIDER=gemini

# ── Google Gemini (free tier) ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI-compatible (OpenRouter / Groq / Together — some free tiers) ───────
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=deepseek/deepseek-r1-distill-qwen-32b:free
# Optional comma-separated fallback models tried on primary failure:
# OPENAI_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct:free,meta-llama/llama-3.3-70b-instruct:free

# ── Anthropic Claude (fallback) ──────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Ollama (local only — NOT usable on Render free tier) ─────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Vision (image questions) ─────────────────────────────────────────────────
# Optional: dedicate a separate provider for image analysis. If unset, the
# primary provider is used (Gemini natively supports vision).
# VISION_API_KEY=your_vision_provider_key
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=google/gemma-4-26b-a4b-it:free

# ── API behaviour ─────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins (default: * = allow any).
# Example: CORS_ORIGINS=https://my-tutor-ui.onrender.com
CORS_ORIGINS=

# Serve the legacy vanilla-JS UI at the API root? (0=off, 1=on)
# Render free-tier note: serve the legacy `frontend/` folder as a stopgap
# until the Next.js frontend is deployed.
SERVE_FRONTEND=1

# ── Generation tuning (optional) ─────────────────────────────────────────────
# LLM_TEMPERATURE=0.7
# SHOW_THINKING=false

# ── Speech (optional — comment in requirements-api.txt first) ────────────────
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# WHISPER_MODEL=base

