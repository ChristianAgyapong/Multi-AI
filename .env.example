# =============================================================================
# Multimodal AI Tutor — Environment Configuration
# =============================================================================
# Copy this file to `.env` and configure your preferred LLM provider.
#
#   cp .env.example .env
#
# Then run: streamlit run app.py   (for Streamlit UI)
#       or: uvicorn backend.api:app --reload   (for FastAPI + custom frontend)
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------
# Set to one of: "ollama", "gemini", "openai", "anthropic"
# If unset, auto-detects: prefers Ollama if running, then Gemini if key found.
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama (FREE, local, unlimited) — RECOMMENDED
# ---------------------------------------------------------------------------
# Install Ollama: https://ollama.ai
# Pull a model:   ollama pull llama3.2
# Then start:     ollama serve
# 
# Models tested: llama3.2 (1.6B), llama3.1 (8B), mistral, phi3, gemma2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Google Gemini (FREE tier, 60 requests/min)
# ---------------------------------------------------------------------------
# Get a free API key: https://aistudio.google.com
# Models: gemini-2.0-flash (fast, free), gemini-1.5-flash, gemini-1.5-pro
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# OpenAI-Compatible (OpenRouter, Groq, Together, etc.)
# ---------------------------------------------------------------------------
# Some providers offer free tiers (check their pricing pages).
# OpenRouter:     https://openrouter.ai
# Groq:           https://groq.com
# Together AI:    https://together.ai
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=https://api.openai.com/v1
# 
# Examples for other providers:
# Groq:           OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:     OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Together AI:   OPENAI_BASE_URL=https://api.together.xyz/v1

# ---------------------------------------------------------------------------
# Anthropic Claude (paid — fallback option)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# ElevenLabs TTS (optional — for higher quality text-to-speech)
# ---------------------------------------------------------------------------
# If not set, the app falls back to gTTS (Google Text-to-Speech, free).
# ELEVENLABS_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Whisper STT Model (optional — voice input)
# ---------------------------------------------------------------------------
# Options: "tiny", "base", "small", "medium", "large-v3"
# Larger models are more accurate but slower and use more RAM.
# WHISPER_MODEL=base

